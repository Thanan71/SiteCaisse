{
  "name": "sitecaisse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "ci": "npm run check && npm test && npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "vercel:prepare": "biome format --write vercel.json && npm run test:e2e:setup",
    "preview": "vite preview",
    "start": "node api/index.cjs",
    "vercel-build": "npm run vercel:prepare && npm run ci"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "vite": "^8.0.12",
    "vitest": "^3.2.7"
  }
}
